{
  "name": "temp-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PUBLIC_APP_VERSION=$npm_package_version next dev -H 0.0.0.0",
    "prebuild": "node scripts/check-netlify-functions.cjs && npm run test:server-runtime",
    "build": "NEXT_PUBLIC_APP_VERSION=$npm_package_version next build",
    "build:app": "NEXT_PUBLIC_BUILD_TARGET=app NEXT_PUBLIC_APP_VERSION=$npm_package_version next build",
    "check:app": "tsc --noEmit && npm run build:app",
    "test:performance": "node --test scripts/test-performance.cjs",
    "test:security": "node --test scripts/test-security.cjs",
    "test:rules": "node --test scripts/test-firestore-rules.cjs",
    "test:netlify": "node --test scripts/test-netlify-functions.cjs",
    "test:server-runtime": "node --no-experimental-require-module --test scripts/test-server-runtime.cjs",
    "cap:sync": "npx cap sync",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-native-navigation": "^8.3.0",
    "@netlify/functions": "^5.3.0",
    "@opentelemetry/api": "^1.9.1",
    "dotenv": "^17.4.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "^11.0.0",
    "groq-sdk": "^1.3.0",
    "jose": "^4.15.9",
    "lucide-react": "^1.22.0",
    "mixpanel-browser": "^2.80.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.17.2",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "$jose"
    }
  },
  "devDependencies": {
    "@types/mixpanel-browser": "^2.60.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "typescript": "^5"
  }
}
